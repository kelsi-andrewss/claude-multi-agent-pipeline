{
  "permissions": {
    "allow": [
      "Bash(~/.claude/hooks/context-check.sh*)",
      "Bash(~/.claude/hooks/cost-alert.sh*)",
      "Bash(~/.claude/hooks/guard-protected-files.sh*)",
      "Bash(~/.claude/hooks/block-enter-worktree.sh*)",
      "Bash(~/.claude/hooks/block-env-read.sh*)",
      "Bash(~/.claude/hooks/session-learning-check.sh*)",
      "Bash(~/.claude/hooks/log-skill-invocation.sh*)",
      "Bash(~/.claude/hooks/track-skill-changes.sh*)",
      "mcp__openmemory__openmemory_store",
      "mcp__openmemory__openmemory_query",
      "Bash(~/.claude/tracking/stop-hook.sh*)",
      "Bash(~/.claude/tracking/subagent-stop-hook.sh*)",
      "Bash(~/.claude/hooks/inject-tier2-context.sh*)",
      "Bash(~/.claude/hooks/inject-project-decisions.sh*)",
      "Bash(~/.claude/hooks/guard-plan-file.sh*)"
    ],
    "defaultMode": "default"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/guard-direct-edit.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/guard-protected-files.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/track-skill-changes.sh",
            "timeout": 5,
            "async": true
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/inject-project-decisions.sh",
            "timeout": 5,
            "async": true
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/warn-sync-heavy-bash.sh",
            "timeout": 5,
            "async": true
          }
        ]
      },
      {
        "matcher": "EnterWorktree",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/block-enter-worktree.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/block-env-read.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "mcp__gemini__pm_update_story",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/guard-plan-file.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "TaskUpdate",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/context-check.sh",
            "timeout": 5,
            "async": true
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/log-skill-invocation.sh",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/cost-alert.sh",
            "timeout": 10,
            "async": true
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/session-learning-check.sh",
            "timeout": 10,
            "async": true
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/tracking/stop-hook.sh",
            "timeout": 30,
            "async": true
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/load-session-context.sh",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/tracking/stop-hook.sh --backfill-only",
            "timeout": 60,
            "async": true
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/tracking/subagent-stop-hook.sh",
            "timeout": 30,
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/inject-tier2-context.sh",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "ralph-loop@claude-plugins-official": true
  },
  "effortLevel": "high",
  "skipDangerousModePermissionPrompt": true
}
